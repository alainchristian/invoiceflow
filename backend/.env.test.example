# Copy this file to .env.test and fill in a DISPOSABLE database -- a separate
# Neon branch/project, never the same DATABASE_URL as your .env. The test
# suite creates and deletes real rows; pointing this at your dev/prod
# database will destroy data.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="test-secret-does-not-need-to-be-real"

# Deliberately left unset -- tests exercise the null-safe "not configured"
# paths for Stripe and email (see backend/src/lib/stripe.ts, lib/email.ts).
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
